---
// Inline SVG icons. Size and colour come from CSS (currentColor), so an icon follows the text around it.
// width/height are only a fallback: if the CSS ever fails to load, the icon stays small instead of filling the page.
import type { IconName } from '../site';
interface Props { name: IconName; class?: string; }
const { name, class: className } = Astro.props;

const stroke = { fill: 'none', stroke: 'currentColor', 'stroke-width': 1.8, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
const filled = name === 'whatsapp' || name === 'trainingpeaks' || name === 'linkedin';
---
<svg class={className} viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" {...(filled ? { fill: 'currentColor' } : stroke)}>
  {name === 'whatsapp' && <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 12 12 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z" />}
  {name === 'phone' && <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.7a2 2 0 0 1 1.7 2z" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>}
  {name === 'trainingpeaks' && <path transform="translate(1.5 2) scale(1 .95)" fill-rule="evenodd" d="M8.96 0h3.87L6.01 15.51H2.14L8.96 0ZM2.22 4.5h3.87L3.87 9.55H0L2.22 4.5Zm9.52 0L4.92 20h3.88l6.81-15.5h-3.87Zm1.11 8.3 4.2-9.55h3.87l-4.2 9.55h-3.87Z" />}
  {name === 'linkedin' && <path d="M6.5 8.75h-3v11h3v-11zM5 3.6a1.75 1.75 0 1 0 0 3.5 1.75 1.75 0 0 0 0-3.5zm5 5.15h-2.9v11H10v-5.6c0-1.5.3-2.9 2.1-2.9 1.8 0 1.8 1.7 1.8 3v5.5h3v-6.1c0-3-.6-5.2-4-5.2-1.6 0-2.7.9-3.1 1.7h-.1V8.75z" />}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" stroke-width="2.4" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" stroke-width="2" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" stroke-width="2" />}
</svg>
