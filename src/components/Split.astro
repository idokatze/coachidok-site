---
// Text beside a photo inside a section: photo above on phones, beside the text on desktop.
// The photo is shown whole, never cropped — the layout adapts to it (same rule as PageHeader).
// `image`: a photo imported from src/assets/images; Astro makes the sizes and WebP copies (same as PageHeader).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { image: ImageMetadata; imageAlt?: string; }
const { image, imageAlt = '' } = Astro.props;
---
<div class="split">
  <div class="split__text"><slot /></div>
  <Image class="split__img" src={image} alt={imageAlt} format="webp" widths={[400, 640, 800, 1000]} sizes="(min-width: 820px) 31rem, 100vw" loading="lazy" decoding="async" />
</div>

<style>
  .split { display: grid; gap: 1.5rem; align-items: center; }
  .split__img { order: -1; width: 100%; height: auto; border-radius: var(--radius); }
  .split__text > :global(:last-child) { margin-bottom: 0; }
  @media (min-width: 820px) {
    .split { grid-template-columns: 1.2fr 1fr; gap: 3rem; }
    .split__img { order: 0; }
  }
</style>
