---
// The Coaching page. One file for both languages: the copy comes from src/i18n (pages/coaching.astro, pages/he/coaching.astro).
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import TextLink from '../components/TextLink.astro';
import ReasonList from '../components/ReasonList.astro';
import Steps from '../components/Steps.astro';
import Cta from '../components/Cta.astro';
import coachSupportingSwimmer from '../assets/images/coach-supporting-swimmer.jpg';
import { localize, site } from '../site';
import { useCopy } from '../i18n';
import { seo } from '../i18n/seo';

const { lang, t } = useCopy(Astro.url.pathname);
const page = seo[lang].coaching;
const c = t.coaching;
---
<Base title={page.title} description={page.description}>
  <PageHeader title={c.title} lead={c.lead} image={coachSupportingSwimmer} imageAlt={c.coachPortraitAlt}>
    <div class="btn-row">
      <Button href={localize('/contact', lang)} arrow>{c.primaryCta}</Button>
      <Button variant="ghost" href={localize('/about', lang)}>{c.secondaryCta}</Button>
    </div>
  </PageHeader>

  <Section soft id="who-i-coach" eyebrow={c.pathsEyebrow} title={c.pathsTitle} lead={c.pathsLead}>
    <div class="card-grid card-grid--2">
      {c.paths.map((path) => (
        <div class="card card--link">
          <p class="eyebrow">{path.label}</p>
          <h3 class="card-title">{path.title}</h3>
          <p>{path.recognition}</p>
          <p>{path.approach}</p>
          <TextLink href={`${localize('/contact', lang)}?goal=${path.goal}`}>{path.cta}</TextLink>
        </div>
      ))}
    </div>
    <div class="section-note">
      <p>{c.runningBody}</p>
      <TextLink href={`${localize('/contact', lang)}?goal=distance-running`}>{c.runningLink}</TextLink>
    </div>
  </Section>

  <Section eyebrow={c.includesEyebrow} title={c.includesTitle}>
    <ReasonList items={c.pillars.map((p) => {
      const linkText = (p as { linkText?: string }).linkText; // Hebrew only — see scripts/check-copy.mjs
      return { label: p.title, text: p.body, link: linkText ? { href: site.theWork, text: linkText, external: true } : undefined };
    })} />
  </Section>

  <Section soft eyebrow={c.processEyebrow} title={c.processTitle} lead={c.processLead}>
    <Steps steps={c.steps} />
  </Section>

  <Cta eyebrow={c.nextEyebrow} title={c.nextTitle} lead={c.nextLead} button={c.nextButton} />
</Base>

