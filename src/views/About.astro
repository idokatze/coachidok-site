---
// The About page. One file for both languages: the copy comes from src/i18n (pages/about.astro, pages/he/about.astro).
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Cta from '../components/Cta.astro';
import ReasonList from '../components/ReasonList.astro';
import coachPortrait from '../assets/images/coach-portrait-lakeside.jpg';
import { site } from '../site';
import { useCopy } from '../i18n';
import { seo } from '../i18n/seo';

const { lang, t } = useCopy(Astro.url.pathname);
const page = seo[lang].about;
const bio = t.coachBio;
---
<Base title={page.title} description={page.description}>
  <PageHeader title={bio.name} image={coachPortrait} imageAlt={t.about.coachPortraitAlt}>
    <p class="role">{bio.title}</p>
    <p>{t.about.introLead}</p>
  </PageHeader>

  <Section soft title={t.about.experienceTitle}>
    <ReasonList items={t.about.experienceItems} />
  </Section>

  <Section title={t.about.pathTitle}>
    <div class="prose">
      {bio.sections.map((section) => (
        <>
          <h3>{section.title}</h3>
          {section.paragraphs.map((paragraph) => {
            // A section may name words in its text that link to idokatze.com (Hebrew only — see scripts/check-copy.mjs)
            const linkText = (section as { linkText?: string }).linkText;
            if (!linkText || !paragraph.includes(linkText)) return <p>{paragraph}</p>;
            const [before, after] = paragraph.split(linkText);
            return <p>{before}<a href={site.theWork} target="_blank" rel="noopener">{linkText}</a>{after}</p>;
          })}
        </>
      ))}
    </div>
  </Section>

  <Cta eyebrow={t.about.ctaEyebrow} title={t.about.ctaTitle} button={t.about.ctaButton} />
</Base>

