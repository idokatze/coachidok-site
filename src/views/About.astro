---
// The About page. One file for both languages: the copy comes from src/i18n (pages/about.astro, pages/he/about.astro).
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Cta from '../components/Cta.astro';
import ReasonList from '../components/ReasonList.astro';
import { useCopy } from '../i18n';
import { seo } from '../i18n/seo';

const { lang, t } = useCopy(Astro.url.pathname);
const page = seo[lang].about;
const bio = t.coachBio;
---
<Base title={page.title} description={page.description}>
  <PageHeader title={bio.name} image="/images/coach-portrait-lakeside-1200.jpg" imageWidth={1200} imageHeight={1200} imageAlt={t.about.coachPortraitAlt}>
    <p class="role">{bio.title}</p>
    <p>{t.about.introLead}</p>
  </PageHeader>

  {/* Experience — English for now; the Hebrew page keeps the previous cards until it has its own copy */}
  {lang === 'en' ? (
    <Section soft title={t.about.experienceTitle}>
      <ReasonList items={t.about.experienceItems} />
    </Section>
  ) : (
    <Section soft>
      <div class="card-grid">
        {bio.experience.map((item) => (
          <div class="card">
            <h2 class="card-title">{item.title}</h2>
            <ul class="facts">{item.points.map((point) => <li>{point}</li>)}</ul>
          </div>
        ))}
      </div>
    </Section>
  )}

  <Section eyebrow={t.about.pathEyebrow} title={t.about.pathTitle}>
    <div class="prose">
      {bio.sections.map((section) => (
        <>
          <h3>{section.title}</h3>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </>
      ))}
    </div>
  </Section>

  <Cta eyebrow={t.about.ctaEyebrow} title={t.about.ctaTitle} button={t.about.ctaButton} />
</Base>

